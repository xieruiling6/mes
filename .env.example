# MySQL connection used by the Spring Boot application
DB_URL="jdbc:mysql://localhost:3306/gongqing_mes?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
DB_USERNAME=root
DB_PASSWORD=change-me-local

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Frontend Vite proxy target
VITE_BACKEND_URL=http://localhost:8080

# Optional MySQL container settings for local provisioning (not read by Spring Boot)
MYSQL_ROOT_PASSWORD=change-me-local
MYSQL_DATABASE=gongqing_mes
